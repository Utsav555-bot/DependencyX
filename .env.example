# DependencyX Environment Variables Configuration

# 1. API & Application
PROJECT_NAME="DependencyX - Software Dependency Risk Map"
VERSION="1.0.0"
SECRET_KEY="dependencyx_super_secret_jwt_signing_key_2026_change_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database Connection
# Local Development (SQLite zero-configuration):
DATABASE_URL="sqlite:///./dependencyx.db"
# Azure SQL Database Production Format:
# DATABASE_URL="mssql+pyodbc://<username>:<password>@<server-name>.database.windows.net:1433/<db-name>?driver=ODBC+Driver+18+for+SQL+Server"

# 3. Microsoft Azure Blob Storage (DP-900)
# Leave blank for local disk fallback (./uploads):
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="dependencyx-manifests"
LOCAL_STORAGE_DIR="./uploads"

# 4. OSV (Open Source Vulnerabilities) API
OSV_API_URL="https://api.osv.dev/v1/query"
OSV_BATCH_API_URL="https://api.osv.dev/v1/querybatch"

# 5. Risk Scoring Weights
WEIGHT_SEVERITY=0.45
WEIGHT_PROPAGATION=0.25
WEIGHT_DEPTH=0.15
WEIGHT_CENTRALITY=0.15

# 6. Frontend Next.js API Target
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
